MISTRAL_API_KEY=your_key_here
ROUTER_MODEL=mistral-small-latest
HEAVY_MODEL=mistral-large-latest
VOXTRAL_MODEL=voxtral-mini-transcribe-realtime-3
VOXTRAL_TARGET_DELAY_MS=480
DEMO_MODE=false

# Optional overrides for live call assistance and generated artifacts
CODE_MODEL=mistral-large-latest
IMAGE_MODEL=mistral-medium-latest
TTS_MODEL=voxtral-mini-tts-3-0
TTS_VOICE_ID=gb_jane_neutral

# Live copilot web research (relative dates use this timezone)
RESEARCH_MODEL=mistral-medium-latest
APP_TIMEZONE=Europe/London
