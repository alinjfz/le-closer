#!/usr/bin/env bash
set -euo pipefail

project_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
if [[ ! -f "$project_dir/.env" ]]; then
  echo "Create .env from .env.example and set your API key and Google credentials path first." >&2
  exit 1
fi

echo "Starting Docker with hot reload: http://localhost:${LECLOSER_WEB_PORT:-5173}"
echo "Press Ctrl+C to stop. Use ./dev -d --wait to run in the background."
exec docker compose --project-directory "$project_dir" \
  -f "$project_dir/docker-compose.dev.yml" up --build "$@"
